# App Config
APP_URL=http://localhost:3000
SELLER_NAME="Your Store Name"
MERCHANT_IBAN=PK00BANK0000000000000000
MERCHANT_CITY="Karachi"
MAX_AMOUNT_RS=500000
PAYMENT_EXPIRY_MINUTES=15
MAX_OFFSET_PAISA=299

# Database
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/adaigi
# Local Development:
MONGODB_URI=mongodb://localhost:27017/adaigi_dev

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here
# Optional: Pre-hashed password alternative
# ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace_with_a_random_jwt_secret_at_least_32_characters_long

# Gmail (IMAP) Sync
GMAIL_ADDRESS=your-bank-alerts@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
GMAIL_FOLDER=INBOX
BANK_SENDER_ALLOWLIST=alerts@yourbank.com,alerts@sc.com,alerts@hbl.com
REQUIRE_EMAIL_AUTH=false
SYNC_LOOKBACK_HOURS=24
SYNC_MIN_INTERVAL_SECONDS=15
# In-process worker interval in seconds (local dev / persistent servers)
SYNC_WORKER_INTERVAL_SECONDS=15
LATE_GRACE_MINUTES=30
EMAIL_RETENTION_DAYS=60

# Vercel Cron Secret (optional)
# Set a random secret string in Vercel to secure /api/cron/sync
CRON_SECRET=
